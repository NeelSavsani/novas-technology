{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "novas-technology",
  "compatibility_date": "2026-09-11",
  "observability": {
    "enabled": true
  },
  "assets": {
    "directory": "."
  },
  "routes": [
    { "pattern": "novastechnology.in", "custom_domain": true },
    { "pattern": "www.novastechnology.in", "custom_domain": true }
  ]
}
